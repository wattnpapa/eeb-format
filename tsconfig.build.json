{
  // Baut das ausgelieferte Paket nach dist/: JavaScript plus Typdeklarationen.
  // Tests und Werkzeugdateien bleiben außen vor.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
